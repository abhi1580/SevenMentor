doctype html 
html(lang="en")
    head
        title LOGIN    
    body
        div(class="container")
            form
                div 
                    label(for='un') Username :  
                    input(type="text", id='un', name='un', required=True,placeholder="Enter username")
                div
                    label(for='pw') Password : 
                    input(type="password", id='pw', name='pw', required=True, placeholder="xxxxxxxxxx")
                div 
                    button(type="submit") Login
                    button(type="reset") Reset
