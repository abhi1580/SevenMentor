doctype html 
html 
    head 
        style 
            include styles/mystyles.css
        title=pageTitle 
    body(bgcolor="gray")
        h2.header=message
        p#pid This is paragraph
        div.container 
            form
                div.form-group
                    label(for="un") Username
                    input(type="text",name="username",placeholder="Username")
                div.form-group 
                    label(for="pw") Password 
                    input(type="password",name="password",placeholder="Password")
                div.form-group 
                    button(type="submit",style="background-color: aqua") Login
